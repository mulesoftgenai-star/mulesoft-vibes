#%RAML 1.0
title: Shipping System API
version: v1.0
baseUri: https://api.shippingsystem.internal/{version}
description: |
  System API for Shipping Management System providing shipment and tracking operations.
  This API interfaces with shipping carriers and provides shipment management services.

protocols: [HTTPS]
mediaType: application/json

uses:
  ShipmentTypes: order-management-api-fragments/src/main/resources/api/datatypes/shipment-types.raml
  ErrorTypes: order-management-api-fragments/src/main/resources/api/datatypes/error-types.raml
  ApiLayerTypes: order-management-api-fragments/src/main/resources/api/datatypes/api-layer-types.raml
  SecurityTraits: order-management-api-fragments/src/main/resources/api/traits/security-traits.raml

traits:
  apiKeyAuth: SecurityTraits.api-key-secured
  systemLogged: SecurityTraits.audit-logged

securitySchemes:
  apiKey:
    description: API Key authentication for system access
    type: x-api-key
    describedBy:
      headers:
        X-API-Key:
          description: API Key for system authentication
          type: string
          example: "ak_1234567890abcdef1234567890abcdef12345678"
          required: true
        X-API-Secret:
          description: API Secret for enhanced security
          type: string
          example: "as_abcdef1234567890abcdef1234567890abcdef12"
          required: false
      responses:
        401:
          description: Unauthorized - Invalid or missing API key
        403:
          description: Forbidden - Valid key but insufficient permissions

/shipments:
  displayName: Shipment Management
  description: Shipment operations for system integration
  
  post:
    displayName: Create Shipment
    description: Create a new shipment for order fulfillment
    is: [apiKeyAuth, systemLogged]
    securedBy: [apiKey]
    body:
      application/json:
        type: ApiLayerTypes.SystemShipmentCreateRequest
        example: |
          {
            "orderId": "ORD-12345678",
            "shipmentId": "SHIP-12345678",
            "items": [
              {
                "lineItemId": "LINE-001",
                "productId": "PROD-12345678",
                "sku": "SKU-ABC-123",
                "quantity": 2,
                "weight": 1.5,
                "weightUnit": "LB",
                "value": 299.99
              }
            ],
            "shippingAddress": {
              "recipientName": "John Doe",
              "addressLine1": "123 Main St",
              "city": "New York",
              "state": "NY",
              "postalCode": "10001",
              "country": "US",
              "phoneNumber": "+1234567890"
            },
            "originAddress": {
              "facilityName": "East Coast Fulfillment Center",
              "addressLine1": "456 Warehouse Ave",
              "city": "Newark",
              "state": "NJ",
              "postalCode": "07102",
              "country": "US"
            },
            "shippingMethod": {
              "methodId": "UPS_GROUND",
              "methodName": "UPS Ground",
              "serviceType": "GROUND"
            },
            "dimensions": {
              "length": 12,
              "width": 8,
              "height": 6,
              "dimensionUnit": "IN",
              "weight": 3.0,
              "weightUnit": "LB"
            },
            "specialInstructions": "Handle with care - fragile items"
          }
    responses:
      201:
        description: Shipment created successfully
        headers:
          Location:
            description: URL of the created shipment
            type: string
        body:
          application/json:
            type: ApiLayerTypes.SystemShipmentCreateResponse
            example: |
              {
                "shipmentId": "SHIP-12345678",
                "trackingNumber": "1Z999AA1234567890",
                "carrier": "UPS",
                "shippingLabel": "JVBERi0xLjQKMSAwIG9iago8PAovVHlwZSAvQ...",
                "estimatedDelivery": "2024-03-28",
                "shippingCost": 12.50,
                "creationTimestamp": "2024-03-24T16:30:00",
                "status": "CREATED"
              }
      400:
        description: Invalid shipment request
        body:
          application/json:
            type: ErrorTypes.ValidationErrorResponse
      409:
        description: Shipment already exists
        body:
          application/json:
            type: ErrorTypes.ConflictErrorResponse
      500:
        description: Shipment creation error
        body:
          application/json:
            type: ErrorTypes.SystemErrorResponse

  get:
    displayName: List Shipments
    description: Retrieve shipment records with filtering and pagination
    is: [apiKeyAuth, systemLogged]
    securedBy: [apiKey]
    queryParameters:
      orderId?:
        type: string
        pattern: ^ORD-[A-Z0-9]{8}$
        description: Filter by order ID
      customerId?:
        type: string
        pattern: ^CUST-[A-Z0-9]{8}$
        description: Filter by customer ID
      status?:
        type: string
        enum: [PENDING, PROCESSING, PICKED, PACKED, LABELED, SHIPPED, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, RETURNED, CANCELLED, EXCEPTION]
        description: Filter by shipment status
      carrier?:
        type: string
        enum: [UPS, FEDEX, USPS, DHL, AMAZON_LOGISTICS, ONTRAC, LASERSHIP, CUSTOM]
        description: Filter by carrier
      trackingNumber?:
        type: string
        description: Filter by tracking number
      dateFrom?:
        type: date-only
        description: Filter shipments from date
      dateTo?:
        type: date-only
        description: Filter shipments to date
      limit?:
        type: integer
        minimum: 1
        maximum: 100
        default: 20
        description: Number of shipments to return
      offset?:
        type: integer
        minimum: 0
        default: 0
        description: Number of shipments to skip
    responses:
      200:
        description: Successfully retrieved shipments
        body:
          application/json:
            type: ShipmentTypes.ShipmentSummary[]
            example: |
              [
                {
                  "shipmentId": "SHIP-12345678",
                  "shipmentNumber": "SHIP-2024-000001",
                  "orderId": "ORD-12345678",
                  "customerId": "CUST-12345678",
                  "shipmentStatus": "IN_TRANSIT",
                  "carrierName": "UPS",
                  "trackingNumber": "1Z999AA1234567890",
                  "createdDate": "2024-03-24T16:30:00",
                  "shippedDate": "2024-03-25T10:00:00",
                  "estimatedDelivery": "2024-03-28T17:00:00",
                  "totalCost": 12.50,
                  "currency": "USD"
                }
              ]
      400:
        description: Bad request
        body:
          application/json:
            type: ErrorTypes.ErrorResponse
      401:
        description: Unauthorized
        body:
          application/json:
            type: ErrorTypes.ErrorResponse
      500:
        description: Internal server error
        body:
          application/json:
            type: ErrorTypes.ErrorResponse

/shipments/{shipmentId}:
  displayName: Shipment Details
  uriParameters:
    shipmentId:
      type: string
      description: Unique shipment identifier
      pattern: ^SHIP-[A-Z0-9]{8}$
      example: "SHIP-12345678"
  
  get:
    displayName: Get Shipment Details
    description: Retrieve detailed shipment information
    is: [apiKeyAuth, systemLogged]
    securedBy: [apiKey]
    responses:
      200:
        description: Shipment details retrieved successfully
        body:
          application/json:
            type: ShipmentTypes.Shipment
            example: |
              {
                "shipmentId": "SHIP-12345678",
                "shipmentNumber": "SHIP-2024-000001",
                "orderId": "ORD-12345678",
                "customerId": "CUST-12345678",
                "shipmentStatus": "IN_TRANSIT",
                "shipmentType": "STANDARD",
                "priority": "NORMAL",
                "carrier": {
                  "carrierId": "UPS",
                  "carrierName": "UPS",
                  "serviceLevel": "GROUND",
                  "serviceName": "UPS Ground"
                },
                "trackingInfo": {
                  "trackingNumber": "1Z999AA1234567890",
                  "currentStatus": "IN_TRANSIT",
                  "lastUpdateTime": "2024-03-26T14:30:00",
                  "currentLocation": {
                    "city": "Philadelphia",
                    "state": "PA",
                    "country": "US"
                  }
                },
                "shippingAddress": {
                  "recipientName": "John Doe",
                  "addressLine1": "123 Main St",
                  "city": "New York",
                  "state": "NY",
                  "postalCode": "10001",
                  "country": "US"
                },
                "items": [
                  {
                    "itemId": "ITEM-001",
                    "productId": "PROD-12345678",
                    "sku": "SKU-ABC-123",
                    "productName": "Wireless Headphones",
                    "quantity": 2,
                    "unitWeight": 0.75,
                    "totalWeight": 1.5,
                    "weightUnit": "LB"
                  }
                ],
                "dimensions": {
                  "length": 12,
                  "width": 8,
                  "height": 6,
                  "dimensionUnit": "IN",
                  "weight": 3.0,
                  "weightUnit": "LB"
                },
                "createdDate": "2024-03-24T16:30:00",
                "shippedDate": "2024-03-25T10:00:00",
                "estimatedDelivery": "2024-03-28T17:00:00"
              }
      404:
        description: Shipment not found
        body:
          application/json:
            type: ErrorTypes.NotFoundErrorResponse
      401:
        description: Unauthorized
        body:
          application/json:
            type: ErrorTypes.AuthenticationErrorResponse
      500:
        description: Internal server error
        body:
          application/json:
            type: ErrorTypes.SystemErrorResponse

  put:
    displayName: Update Shipment
    description: Update shipment information and status
    is: [apiKeyAuth, systemLogged]
    securedBy: [apiKey]
    body:
      application/json:
        type: ShipmentTypes.ShipmentStatusUpdate
        example: |
          {
            "shipmentId": "SHIP-12345678",
            "newStatus": "SHIPPED",
            "reason": "Package dispatched from fulfillment center",
            "updatedBy": "FULFILLMENT_SYSTEM",
            "timestamp": "2024-03-25T10:00:00",
            "location": {
              "facilityName": "East Coast Fulfillment Center",
              "city": "Newark",
              "state": "NJ",
              "country": "US"
            },
            "trackingNumber": "1Z999AA1234567890"
          }
    responses:
      200:
        description: Shipment updated successfully
        body:
          application/json:
            type: ShipmentTypes.Shipment
      400:
        description: Invalid update data
        body:
          application/json:
            type: ErrorTypes.ValidationErrorResponse
      404:
        description: Shipment not found
        body:
          application/json:
            type: ErrorTypes.NotFoundErrorResponse
      409:
        description: Invalid status transition
        body:
          application/json:
            type: ErrorTypes.ConflictErrorResponse
      500:
        description: Update service error
        body:
          application/json:
            type: ErrorTypes.SystemErrorResponse

/shipments/{shipmentId}/tracking:
  displayName: Shipment Tracking
  uriParameters:
    shipmentId:
      type: string
      description: Unique shipment identifier
      pattern: ^SHIP-[A-Z0-9]{8}$
  
  get:
    displayName: Get Tracking Information
    description: Retrieve detailed tracking information for a shipment
    is: [apiKeyAuth, systemLogged]
    securedBy: [apiKey]
    responses:
      200:
        description: Tracking information retrieved successfully
        body:
          application/json:
            type: object
            properties:
              shipmentId:
                type: string
              trackingNumber:
                type: string
              carrier:
                type: string
                enum: [UPS, FEDEX, USPS, DHL, AMAZON_LOGISTICS, ONTRAC, LASERSHIP, CUSTOM]
              currentStatus:
                type: string
                enum: [LABEL_CREATED, PICKED_UP, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, EXCEPTION, RETURNED]
              estimatedDelivery:
                type: datetime-only
              actualDelivery:
                type: datetime-only
              trackingEvents:
                type: object[]
                properties:
                  timestamp:
                    type: datetime-only
                  status:
                    type: string
                  description:
                    type: string
                  location:
                    type: object
                    properties:
                      city:
                        type: string
                      state:
                        type: string
                      country:
                        type: string
              deliveryProof:
                type: object
                properties:
                  deliveryDate:
                    type: datetime-only
                  signatureName:
                    type: string
                  deliveredTo:
                    type: string
            example: |
              {
                "shipmentId": "SHIP-12345678",
                "trackingNumber": "1Z999AA1234567890",
                "carrier": "UPS",
                "currentStatus": "IN_TRANSIT",
                "estimatedDelivery": "2024-03-28T17:00:00",
                "trackingEvents": [
                  {
                    "timestamp": "2024-03-25T10:00:00",
                    "status": "PICKED_UP",
                    "description": "Package picked up",
                    "location": {
                      "city": "Newark",
                      "state": "NJ",
                      "country": "US"
                    }
                  },
                  {
                    "timestamp": "2024-03-26T14:30:00",
                    "status": "IN_TRANSIT",
                    "description": "Package in transit",
                    "location": {
                      "city": "Philadelphia",
                      "state": "PA",
                      "country": "US"
                    }
                  }
                ]
              }
      404:
        description: Shipment or tracking information not found
        body:
          application/json:
            type: ErrorTypes.NotFoundErrorResponse
      500:
        description: Tracking service error
        body:
          application/json:
            type: ErrorTypes.SystemErrorResponse

/shipments/{shipmentId}/labels:
  displayName: Shipping Labels
  uriParameters:
    shipmentId:
      type: string
      description: Unique shipment identifier
      pattern: ^SHIP-[A-Z0-9]{8}$
  
  get:
    displayName: Get Shipping Label
    description: Retrieve shipping label for a shipment
    is: [apiKeyAuth, systemLogged]
    securedBy: [apiKey]
    queryParameters:
      format?:
        type: string
        enum: [PDF, PNG, ZPL, EPL]
        default: PDF
        description: Label format
      size?:
        type: string
        enum: [4X6, 4X8, 8.5X11]
        default: 4X6
        description: Label size
    responses:
      200:
        description: Shipping label retrieved successfully
        body:
          application/json:
            type: object
            properties:
              shipmentId:
                type: string
              labelData:
                type: string
                description: Base64 encoded label data
              format:
                type: string
              size:
                type: string
              generatedAt:
                type: datetime-only
            example: |
              {
                "shipmentId": "SHIP-12345678",
                "labelData": "JVBERi0xLjQKMSAwIG9iago8PAovVHlwZSAvQ...",
                "format": "PDF",
                "size": "4X6",
                "generatedAt": "2024-03-24T16:30:00"
              }
      404:
        description: Shipment not found
        body:
          application/json:
            type: ErrorTypes.NotFoundErrorResponse
      500:
        description: Label generation error
        body:
          application/json:
            type: ErrorTypes.SystemErrorResponse

/shipments/{shipmentId}/cancel:
  displayName: Cancel Shipment
  uriParameters:
    shipmentId:
      type: string
      description: Unique shipment identifier
      pattern: ^SHIP-[A-Z0-9]{8}$
  
  post:
    displayName: Cancel Shipment
    description: Cancel a shipment before it's picked up
    is: [apiKeyAuth, systemLogged]
    securedBy: [apiKey]
    body:
      application/json:
        type: object
        properties:
          cancelReason:
            type: string
            enum: [ORDER_CANCELLED, CUSTOMER_REQUEST, INVENTORY_ISSUE, ADDRESS_ISSUE, OTHER]
            description: Reason for cancellation
            required: true
          notes?:
            type: string
            maxLength: 500
            description: Additional cancellation notes
          cancelledBy:
            type: string
            description: System or user cancelling the shipment
            required: true
        example: |
          {
            "cancelReason": "ORDER_CANCELLED",
            "notes": "Customer cancelled order before shipment",
            "cancelledBy": "ORDER_SYSTEM"
          }
    responses:
      200:
        description: Shipment cancelled successfully
        body:
          application/json:
            type: object
            properties:
              shipmentId:
                type: string
              status:
                type: string
                enum: [CANCELLED]
              cancelledAt:
                type: datetime-only
              refundAmount:
                type: number
              message:
                type: string
            example: |
              {
                "shipmentId": "SHIP-12345678",
                "status": "CANCELLED",
                "cancelledAt": "2024-03-24T17:00:00",
                "refundAmount": 12.50,
                "message": "Shipment cancelled successfully"
              }
      400:
        description: Invalid cancellation request
        body:
          application/json:
            type: ErrorTypes.ValidationErrorResponse
      404:
        description: Shipment not found
        body:
          application/json:
            type: ErrorTypes.NotFoundErrorResponse
      409:
        description: Shipment cannot be cancelled (already shipped)
        body:
          application/json:
            type: ErrorTypes.ConflictErrorResponse
      500:
        description: Cancellation service error
        body:
          application/json:
            type: ErrorTypes.SystemErrorResponse

/carriers:
  displayName: Carrier Management
  description: Carrier information and services
  
  get:
    displayName: List Carriers
    description: Retrieve available shipping carriers and their services
    is: [apiKeyAuth, systemLogged]
    securedBy: [apiKey]
    queryParameters:
      serviceType?:
        type: string
        enum: [GROUND, EXPRESS, OVERNIGHT, SAME_DAY, FREIGHT, INTERNATIONAL]
        description: Filter by service type
      active?:
        type: boolean
        default: true
        description: Filter by active status
    responses:
      200:
        description: Carriers retrieved successfully
        body:
          application/json:
            type: object[]
            properties:
              carrierId:
                type: string
              carrierName:
                type: string
                enum: [UPS, FEDEX, USPS, DHL, AMAZON_LOGISTICS, ONTRAC, LASERSHIP, CUSTOM]
              services:
                type: object[]
                properties:
                  serviceId:
                    type: string
                  serviceName:
                    type: string
                  serviceType:
                    type: string
                  estimatedDays:
                    type: integer
                  guaranteedDelivery:
                    type: boolean
            example: |
              [
                {
                  "carrierId": "UPS",
                  "carrierName": "UPS",
                  "services": [
                    {
                      "serviceId": "UPS_GROUND",
                      "serviceName": "UPS Ground",
                      "serviceType": "GROUND",
                      "estimatedDays": 3,
                      "guaranteedDelivery": false
                    },
                    {
                      "serviceId": "UPS_NEXT_DAY",
                      "serviceName": "UPS Next Day Air",
                      "serviceType": "OVERNIGHT",
                      "estimatedDays": 1,
                      "guaranteedDelivery": true
                    }
                  ]
                }
              ]
      500:
        description: Carrier service error
        body:
          application/json:
            type: ErrorTypes.SystemErrorResponse

/rates:
  displayName: Shipping Rates
  description: Calculate shipping rates and delivery estimates
  
  post:
    displayName: Calculate Rates
    description: Calculate shipping rates for given shipment details
    is: [apiKeyAuth, systemLogged]
    securedBy: [apiKey]
    body:
      application/json:
        type: object
        properties:
          originAddress:
            type: object
            properties:
              city:
                type: string
              state:
                type: string
              postalCode:
                type: string
              country:
                type: string
            required: true
          destinationAddress:
            type: object
            properties:
              city:
                type: string
              state:
                type: string
              postalCode:
                type: string
              country:
                type: string
            required: true
          packages:
            type: object[]
            properties:
              weight:
                type: number
              weightUnit:
                type: string
                enum: [LB, KG, OZ, G]
              length:
                type: number
              width:
                type: number
              height:
                type: number
              dimensionUnit:
                type: string
                enum: [IN, CM, FT, M]
              value:
                type: number
            minItems: 1
            required: true
          carriers?:
            type: string[]
            description: Specific carriers to get rates from
        example: |
          {
            "originAddress": {
              "city": "Newark",
              "state": "NJ",
              "postalCode": "07102",
              "country": "US"
            },
            "destinationAddress": {
              "city": "New York",
              "state": "NY",
              "postalCode": "10001",
              "country": "US"
            },
            "packages": [
              {
                "weight": 3.0,
                "weightUnit": "LB",
                "length": 12,
                "width": 8,
                "height": 6,
                "dimensionUnit": "IN",
                "value": 299.99
              }
            ],
            "carriers": ["UPS", "FEDEX"]
          }
    responses:
      200:
        description: Shipping rates calculated successfully
        body:
          application/json:
            type: object
            properties:
              rateId:
                type: string
              rates:
                type: object[]
                properties:
                  carrier:
                    type: string
                  service:
                    type: string
                  serviceName:
                    type: string
                  cost:
                    type: number
                  currency:
                    type: string
                  estimatedDays:
                    type: integer
                  guaranteedDelivery:
                    type: boolean
                  deliveryDate:
                    type: date-only
            example: |
              {
                "rateId": "RATE-12345678",
                "rates": [
                  {
                    "carrier": "UPS",
                    "service": "UPS_GROUND",
                    "serviceName": "UPS Ground",
                    "cost": 12.50,
                    "currency