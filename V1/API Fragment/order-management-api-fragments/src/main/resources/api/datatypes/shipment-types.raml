#%RAML 1.0 Library

usage: |
  This library contains data types for Shipment Management within Order Management APIs.
  It defines Shipment, Tracking, and related structures for Experience, Process, and System layer APIs.

types:
  Shipment:
    displayName: Shipment
    description: Complete shipment information including tracking, carrier details, and delivery information
    type: object
    properties:
      shipmentId:
        type: string
        description: Unique shipment identifier
        pattern: ^SHIP-[A-Z0-9]{8}$
        example: SHIP-12345678
        required: true
      shipmentNumber:
        type: string
        description: Human-readable shipment number
        example: "SHIP-2024-000001"
        required: true
      orderId:
        type: string
        description: Associated order identifier
        pattern: ^ORD-[A-Z0-9]{8}$
        example: ORD-87654321
        required: true
      customerId:
        type: string
        description: Customer identifier
        pattern: ^CUST-[A-Z0-9]{8}$
        example: CUST-11223344
        required: true
      shipmentStatus:
        type: string
        description: Current shipment status
        enum: [PENDING, PROCESSING, PICKED, PACKED, LABELED, SHIPPED, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, RETURNED, CANCELLED, EXCEPTION]
        example: IN_TRANSIT
        required: true
      shipmentType:
        type: string
        description: Type of shipment
        enum: [STANDARD, EXPRESS, OVERNIGHT, SAME_DAY, FREIGHT, BULK]
        example: STANDARD
        required: true
      priority:
        type: string
        description: Shipment priority level
        enum: [LOW, NORMAL, HIGH, URGENT, CRITICAL]
        example: NORMAL
        required: false
      carrier:
        type: CarrierInfo
        description: Carrier information
        required: true
      trackingInfo:
        type: TrackingInfo
        description: Tracking information
        required: true
      shippingAddress:
        type: ShippingAddress
        description: Destination shipping address
        required: true
      originAddress:
        type: OriginAddress
        description: Origin/fulfillment center address
        required: true
      items:
        type: ShipmentItem[]
        description: Items included in shipment
        minItems: 1
        required: true
      dimensions:
        type: PackageDimensions
        description: Package dimensions and weight
        required: true
      shippingMethod:
        type: ShippingMethod
        description: Shipping method details
        required: true
      costs:
        type: ShippingCosts
        description: Shipping costs breakdown
        required: false
      insurance:
        type: ShippingInsurance
        description: Shipping insurance information
        required: false
      specialServices:
        type: SpecialService[]
        description: Additional services (signature, COD, etc.)
        required: false
      customsInfo:
        type: CustomsInfo
        description: Customs information for international shipments
        required: false
      createdDate:
        type: datetime-only
        description: Shipment creation timestamp
        required: true
      shippedDate:
        type: datetime-only
        description: Actual ship date
        required: false
      estimatedDelivery:
        type: datetime-only
        description: Estimated delivery date and time
        required: false
      actualDelivery:
        type: datetime-only
        description: Actual delivery date and time
        required: false
      deliverySignature:
        type: string
        description: Delivery signature (if obtained)
        maxLength: 100
        required: false
      specialInstructions:
        type: string
        description: Special handling or delivery instructions
        maxLength: 500
        required: false
      notes:
        type: string
        description: Internal shipment notes
        maxLength: 1000
        required: false
      createdBy:
        type: string
        description: User or system that created the shipment
        required: true
      lastModifiedDate:
        type: datetime-only
        description: Last modification timestamp
        required: false
      version:
        type: integer
        description: Shipment version for optimistic locking
        minimum: 1
        example: 1
        required: false

  CarrierInfo:
    displayName: Carrier Information
    description: Shipping carrier details
    type: object
    properties:
      carrierId:
        type: string
        description: Unique carrier identifier
        required: true
      carrierName:
        type: string
        description: Carrier company name
        enum: [UPS, FEDEX, USPS, DHL, AMAZON_LOGISTICS, ONTRAC, LASERSHIP, CUSTOM]
        required: true
      carrierCode:
        type: string
        description: Standard carrier code
        maxLength: 10
        required: false
      serviceLevel:
        type: string
        description: Service level offered by carrier
        enum: [GROUND, EXPRESS, OVERNIGHT, SAME_DAY, FREIGHT, INTERNATIONAL]
        required: true
      serviceName:
        type: string
        description: Human-readable service name
        example: "UPS Ground"
        required: false
      carrierAccountNumber:
        type: string
        description: Account number with carrier (if applicable)
        required: false
      contactInfo:
        type: CarrierContact
        description: Carrier contact information
        required: false

  CarrierContact:
    displayName: Carrier Contact
    description: Contact information for carrier
    type: object
    properties:
      phoneNumber:
        type: string
        pattern: ^\+?[1-9]\d{1,14}$
        required: false
      email:
        type: string
        pattern: ^[^\s@]+@[^\s@]+\.[^\s@]+$
        required: false
      website:
        type: string
        description: Carrier website URL
        required: false
      customerService:
        type: string
        description: Customer service phone number
        pattern: ^\+?[1-9]\d{1,14}$
        required: false

  TrackingInfo:
    displayName: Tracking Information
    description: Comprehensive tracking details
    type: object
    properties:
      trackingNumber:
        type: string
        description: Primary tracking number
        required: true
      alternateTrackingNumbers:
        type: string[]
        description: Additional tracking numbers (if any)
        required: false
      trackingUrl:
        type: string
        description: URL for tracking the shipment
        required: false
      currentStatus:
        type: string
        description: Current tracking status
        enum: [LABEL_CREATED, PICKED_UP, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, EXCEPTION, RETURNED]
        required: true
      statusDescription:
        type: string
        description: Detailed status description
        maxLength: 200
        required: false
      lastUpdateTime:
        type: datetime-only
        description: Last tracking update timestamp
        required: false
      currentLocation:
        type: TrackingLocation
        description: Current package location
        required: false
      trackingEvents:
        type: TrackingEvent[]
        description: Complete tracking history
        required: false
      deliveryProof:
        type: DeliveryProof
        description: Proof of delivery information
        required: false

  TrackingLocation:
    displayName: Tracking Location
    description: Current location of shipment
    type: object
    properties:
      facilityName:
        type: string
        description: Facility or location name
        required: false
      city:
        type: string
        required: false
      state:
        type: string
        required: false
      country:
        type: string
        pattern: ^[A-Z]{2}$
        required: false
      coordinates:
        type: GeoCoordinates
        description: GPS coordinates
        required: false

  GeoCoordinates:
    displayName: Geographic Coordinates
    description: GPS coordinates for location tracking
    type: object
    properties:
      latitude:
        type: number
        description: Latitude coordinate
        minimum: -90
        maximum: 90
        required: true
      longitude:
        type: number
        description: Longitude coordinate
        minimum: -180
        maximum: 180
        required: true
      accuracy:
        type: number
        description: Accuracy in meters
        minimum: 0
        required: false

  TrackingEvent:
    displayName: Tracking Event
    description: Individual tracking event in shipment history
    type: object
    properties:
      eventId:
        type: string
        description: Unique event identifier
        required: false
      timestamp:
        type: datetime-only
        description: Event timestamp
        required: true
      status:
        type: string
        description: Event status
        enum: [LABEL_CREATED, PICKED_UP, IN_TRANSIT, SORTING, OUT_FOR_DELIVERY, DELIVERED, EXCEPTION, RETURNED, CANCELLED]
        required: true
      description:
        type: string
        description: Event description
        maxLength: 200
        required: false
      location:
        type: TrackingLocation
        description: Event location
        required: false
      facilityType:
        type: string
        description: Type of facility where event occurred
        enum: [ORIGIN, HUB, SORT_FACILITY, DESTINATION, DELIVERY_LOCATION, CUSTOMER]
        required: false

  DeliveryProof:
    displayName: Delivery Proof
    description: Proof of delivery information
    type: object
    properties:
      deliveryDate:
        type: datetime-only
        description: Actual delivery date and time
        required: true
      signatureName:
        type: string
        description: Name of person who signed
        maxLength: 100
        required: false
      signatureImage:
        type: string
        description: Base64 encoded signature image
        required: false
      photoProof:
        type: string
        description: Base64 encoded delivery photo
        required: false
      deliveryLocation:
        type: string
        description: Where package was left
        enum: [FRONT_DOOR, BACK_DOOR, SIDE_DOOR, PORCH, MAILBOX, OFFICE, RECEPTION, NEIGHBOR, OTHER]
        required: false
      deliveredTo:
        type: string
        description: Person who received the package
        maxLength: 100
        required: false

  ShippingAddress:
    displayName: Shipping Address
    description: Destination address for shipment
    type: object
    properties:
      addressId:
        type: string
        description: Unique address identifier
        required: false
      recipientName:
        type: string
        description: Full name of recipient
        maxLength: 100
        required: true
      company:
        type: string
        description: Company name
        maxLength: 100
        required: false
      addressLine1:
        type: string
        description: Street address line 1
        maxLength: 100
        required: true
      addressLine2:
        type: string
        description: Street address line 2
        maxLength: 100
        required: false
      city:
        type: string
        maxLength: 50
        required: true
      state:
        type: string
        maxLength: 50
        required: true
      postalCode:
        type: string
        pattern: ^[0-9A-Z\-\s]{3,10}$
        required: true
      country:
        type: string
        pattern: ^[A-Z]{2}$
        example: US
        required: true
      phoneNumber:
        type: string
        pattern: ^\+?[1-9]\d{1,14}$
        required: false
      email:
        type: string
        pattern: ^[^\s@]+@[^\s@]+\.[^\s@]+$
        required: false
      deliveryInstructions:
        type: string
        description: Special delivery instructions
        maxLength: 500
        required: false
      isResidential:
        type: boolean
        description: Whether address is residential
        default: true
        required: false

  OriginAddress:
    displayName: Origin Address
    description: Origin/fulfillment center address
    type: object
    properties:
      facilityId:
        type: string
        description: Facility identifier
        required: false
      facilityName:
        type: string
        description: Facility or warehouse name
        required: true
      company:
        type: string
        description: Company name
        required: false
      addressLine1:
        type: string
        maxLength: 100
        required: true
      addressLine2:
        type: string
        maxLength: 100
        required: false
      city:
        type: string
        maxLength: 50
        required: true
      state:
        type: string
        maxLength: 50
        required: true
      postalCode:
        type: string
        pattern: ^[0-9A-Z\-\s]{3,10}$
        required: true
      country:
        type: string
        pattern: ^[A-Z]{2}$
        required: true
      phoneNumber:
        type: string
        pattern: ^\+?[1-9]\d{1,14}$
        required: false
      contactPerson:
        type: string
        description: Contact person at facility
        maxLength: 100
        required: false

  ShipmentItem:
    displayName: Shipment Item
    description: Individual item in shipment
    type: object
    properties:
      itemId:
        type: string
        description: Unique item identifier within shipment
        required: true
      orderItemId:
        type: string
        description: Reference to order item
        required: false
      productId:
        type: string
        description: Product identifier
        pattern: ^PROD-[A-Z0-9]{8}$
        required: true
      sku:
        type: string
        description: Stock Keeping Unit
        required: true
      productName:
        type: string
        description: Product name
        maxLength: 200
        required: true
      quantity:
        type: integer
        description: Quantity shipped
        minimum: 1
        required: true
      unitWeight:
        type: number
        description: Weight per unit
        minimum: 0
        required: false
      totalWeight:
        type: number
        description: Total weight for this item
        minimum: 0
        required: false
      weightUnit:
        type: string
        enum: [LB, KG, OZ, G]
        default: LB
        required: false
      dimensions:
        type: ItemDimensions
        description: Item dimensions
        required: false
      value:
        type: number
        description: Item value for insurance/customs
        minimum: 0
        required: false
      currency:
        type: string
        pattern: ^[A-Z]{3}$
        default: USD
        required: false
      hsCode:
        type: string
        description: Harmonized System code for customs
        required: false
      countryOfOrigin:
        type: string
        description: Country where item was manufactured
        pattern: ^[A-Z]{2}$
        required: false
      serialNumbers:
        type: string[]
        description: Serial numbers (if applicable)
        required: false

  ItemDimensions:
    displayName: Item Dimensions
    description: Physical dimensions of individual item
    type: object
    properties:
      length:
        type: number
        minimum: 0
        required: true
      width:
        type: number
        minimum: 0
        required: true
      height:
        type: number
        minimum: 0
        required: true
      unit:
        type: string
        enum: [IN, CM, FT, M]
        default: IN
        required: true

  PackageDimensions:
    displayName: Package Dimensions
    description: Physical dimensions and weight of complete package
    type: object
    properties:
      length:
        type: number
        description: Package length
        minimum: 0
        required: true
      width:
        type: number
        description: Package width
        minimum: 0
        required: true
      height:
        type: number
        description: Package height
        minimum: 0
        required: true
      dimensionUnit:
        type: string
        enum: [IN, CM, FT, M]
        default: IN
        required: true
      weight:
        type: number
        description: Total package weight
        minimum: 0
        required: true
      weightUnit:
        type: string
        enum: [LB, KG, OZ, G]
        default: LB
        required: true
      volumetricWeight:
        type: number
        description: Calculated volumetric weight
        minimum: 0
        required: false
      billableWeight:
        type: number
        description: Weight used for billing (max of actual and volumetric)
        minimum: 0
        required: false

  ShippingMethod:
    displayName: Shipping Method
    description: Detailed shipping method information
    type: object
    properties:
      methodId:
        type: string
        description: Unique shipping method identifier
        required: true
      methodName:
        type: string
        description: Shipping method name
        example: "UPS Ground"
        required: true
      methodCode:
        type: string
        description: Internal method code
        required: false
      serviceType:
        type: string
        enum: [GROUND, EXPRESS, OVERNIGHT, SAME_DAY, FREIGHT, INTERNATIONAL]
        required: true
      deliveryDays:
        type: integer
        description: Estimated delivery days
        minimum: 0
        required: false
      guaranteedDelivery:
        type: boolean
        description: Whether delivery is guaranteed
        default: false
        required: false
      signatureRequired:
        type: boolean
        description: Whether signature is required
        default: false
        required: false
      insuranceIncluded:
        type: boolean
        description: Whether insurance is included
        default: false
        required: false
      trackingIncluded:
        type: boolean
        description: Whether tracking is included
        default: true
        required: false

  ShippingCosts:
    displayName: Shipping Costs
    description: Breakdown of shipping costs
    type: object
    properties:
      baseCost:
        type: number
        description: Base shipping cost
        minimum: 0
        required: true
      fuelSurcharge:
        type: number
        description: Fuel surcharge
        minimum: 0
        required: false
      residentialSurcharge:
        type: number
        description: Residential delivery surcharge
        minimum: 0
        required: false
      signatureFee:
        type: number
        description: Signature confirmation fee
        minimum: 0
        required: false
      insuranceFee:
        type: number
        description: Insurance fee
        minimum: 0
        required: false
      packagingFee:
        type: number
        description: Packaging fee
        minimum: 0
        required: false
      handlingFee:
        type: number
        description: Handling fee
        minimum: 0
        required: false
      taxes:
        type: number
        description: Applicable taxes
        minimum: 0
        required: false
      totalCost:
        type: number
        description: Total shipping cost
        minimum: 0
        required: true
      currency:
        type: string
        pattern: ^[A-Z]{3}$
        default: USD
        required: true
      discounts:
        type: ShippingDiscount[]
        description: Applied shipping discounts
        required: false

  ShippingDiscount:
    displayName: Shipping Discount
    description: Discount applied to shipping costs
    type: object
    properties:
      discountId:
        type: string
        description: Discount identifier
        required: true
      discountType:
        type: string
        enum: [PERCENTAGE, FIXED_AMOUNT, FREE_SHIPPING, BULK_DISCOUNT]
        required: true
      discountName:
        type: string
        description: Human-readable discount name
        required: true
      discountAmount:
        type: number
        description: Discount amount
        minimum: 0
        required: true
      discountPercentage:
        type: number
        description: Discount percentage (if applicable)
        minimum: 0
        maximum: 100
        required: false

  ShippingInsurance:
    displayName: Shipping Insurance
    description: Insurance information for shipment
    type: object
    properties:
      insured:
        type: boolean
        description: Whether shipment is insured
        default: false
        required: true
      insuranceProvider:
        type: string
        description: Insurance provider name
        required: false
      policyNumber:
        type: string
        description: Insurance policy number
        required: false
      insuredValue:
        type: number
        description: Total insured value
        minimum: 0
        required: false
      premium:
        type: number
        description: Insurance premium cost
        minimum: 0
        required: false
      currency:
        type: string
        pattern: ^[A-Z]{3}$
        default: USD
        required: false
      coverage:
        type: string[]
        description: Types of coverage included
        enum: [LOSS, DAMAGE, THEFT, DELAY]
        required: false

  SpecialService:
    displayName: Special Service
    description: Additional shipping services
    type: object
    properties:
      serviceId:
        type: string
        description: Unique service identifier
        required: true
      serviceName:
        type: string
        description: Service name
        required: true
      serviceType:
        type: string
        enum: [SIGNATURE_CONFIRMATION, ADULT_SIGNATURE, CASH_ON_DELIVERY, SATURDAY_DELIVERY, HOLD_FOR_PICKUP, RETURN_RECEIPT]
        required: true
      cost:
        type: number
        description: Additional cost for service
        minimum: 0
        required: false
      currency:
        type: string
        pattern: ^[A-Z]{3}$
        default: USD
        required: false
      description:
        type: string
        description: Service description
        maxLength: 200
        required: false

  CustomsInfo:
    displayName: Customs Information
    description: Customs information for international shipments
    type: object
    properties:
      customsValue:
        type: number
        description: Total customs declared value
        minimum: 0
        required: true
      currency:
        type: string
        pattern: ^[A-Z]{3}$
        required: true
      reasonForExport:
        type: string
        enum: [SALE, GIFT, SAMPLE, RETURN, REPAIR, PERSONAL_USE, OTHER]
        required: true
      customsDescription:
        type: string
        description: General description of contents
        maxLength: 200
        required: false
      dutyPaid:
        type: boolean
        description: Whether duties are prepaid
        default: false
        required: false
      customsDocuments:
        type: CustomsDocument[]
        description: Required customs documents
        required: false
      restrictions:
        type: string[]
        description: Known shipping restrictions
        required: false

  CustomsDocument:
    displayName: Customs Document
    description: Individual customs document
    type: object
    properties:
      documentType:
        type: string
        enum: [COMMERCIAL_INVOICE, PACKING_LIST, CERTIFICATE_OF_ORIGIN, EXPORT_LICENSE, OTHER]
        required: true
      documentNumber:
        type: string
        description: Document number/identifier
        required: false
      documentUrl:
        type: string
        description: URL to document (if electronic)
        required: false

  ShipmentRequest:
    displayName: Shipment Request
    description: Request payload for creating a new shipment
    type: object
    properties:
      orderId:
        type: string
        pattern: ^ORD-[A-Z0-9]{8}$
        required: true
      customerId:
        type: string
        pattern: ^CUST-[A-Z0-9]{8}$
        required: true
      items:
        type: ShipmentItem[]
        minItems: 1
        required: true
      shippingAddress:
        type: ShippingAddress
        required: true
      originAddress:
        type: OriginAddress
        required: true
      shippingMethod:
        type: ShippingMethod
        required: true
      dimensions:
        type: PackageDimensions
        required: true
      specialServices:
        type: SpecialService[]
        required: false
      insurance:
        type: ShippingInsurance
        required: false
      customsInfo:
        type: CustomsInfo
        required: false
      specialInstructions:
        type: string
        maxLength: 500
        required: false
      requestedBy:
        type: string
        required: true

  ShipmentSummary:
    displayName: Shipment Summary
    description: Lightweight shipment representation for list views
    type: object
    properties:
      shipmentId:
        type: string
        required: true
      shipmentNumber:
        type: string
        required: true
      orderId:
        type: string
        required: true
      customerId:
        type: string
        required: true
      shipmentStatus:
        type: string
        enum: [PENDING, PROCESSING, PICKED, PACKED, LABELED, SHIPPED, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, RETURNED, CANCELLED, EXCEPTION]
        required: true
      carrierName:
        type: string
        required: true
      trackingNumber:
        type: string
        required: true
      createdDate:
        type: datetime-only
        required: true
      shippedDate:
        type: datetime-only
        required: false
      estimatedDelivery:
        type: datetime-only
        required: false
      totalCost:
        type: number
        required: false
      currency:
        type: string
        required: false

  ShipmentStatusUpdate:
    displayName: Shipment Status Update
    description: Request payload for updating shipment status
    type: object
    properties:
      shipmentId:
        type: string
        required: true
      newStatus:
        type: string
        enum: [PENDING, PROCESSING, PICKED, PACKED, LABELED, SHIPPED, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, RETURNED, CANCELLED, EXCEPTION]
        required: true
      reason:
        type: string
        description: Reason for status change
        maxLength: 500
        required: false
      updatedBy:
        type: string
        description: User or system making the update
        required: true
      timestamp:
        type: datetime-only
        required: true
      location:
        type: TrackingLocation
        description: Location where status change occurred
        required: false
      notes:
        type: string
        maxLength: 1000
        required: false
      trackingNumber:
        type: string
        description: Associated tracking number
        required: false
