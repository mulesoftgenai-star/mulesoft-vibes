#%RAML 1.0 Library

types:
  # Base Types
  ID:
    type: string
    pattern: ^[A-Z0-9]{10}$
    description: Standard identifier format
    example: "PRD1234567"

  Product:
    type: object
    properties:
      productId:
        type: ID
        description: Unique product identifier
      name:
        type: string
        minLength: 1
        maxLength: 200
        description: Product name
      sku:
        type: string
        minLength: 1
        maxLength: 50
        description: Stock keeping unit
      description:
        type: string
        required: false
        maxLength: 1000
        description: Product description
      category:
        type: string
        maxLength: 100
        description: Product category
      brand:
        type: string
        required: false
        maxLength: 100
        description: Product brand
      price:
        type: number
        minimum: 0
        multipleOf: 0.01
        description: Product price
      currency:
        type: string
        pattern: ^[A-Z]{3}$
        description: Price currency
      status:
        type: string
        enum: [ACTIVE, INACTIVE, DISCONTINUED]
        description: Product status
      createdAt:
        type: datetime
        format: rfc3339
      updatedAt:
        type: datetime
        format: rfc3339
    example:
      productId: "PRD1234567"
      name: "Premium Wireless Headphones"
      sku: "WHD-PREM-001"
      description: "High-quality wireless headphones with noise cancellation"
      category: "Electronics"
      brand: "TechBrand"
      price: 199.99
      currency: "USD"
      status: "ACTIVE"
      createdAt: "2024-01-15T10:30:00.000Z"
      updatedAt: "2024-03-27T15:30:00.000Z"

  Inventory:
    type: object
    properties:
      inventoryId:
        type: ID
        description: Unique inventory record identifier
      productId:
        type: ID
        description: Product identifier
      warehouseId:
        type: ID
        description: Warehouse identifier
      availableQuantity:
        type: integer
        minimum: 0
        description: Available quantity for sale
      reservedQuantity:
        type: integer
        minimum: 0
        description: Reserved quantity (pending orders)
      totalQuantity:
        type: integer
        minimum: 0
        description: Total quantity in stock
      reorderLevel:
        type: integer
        minimum: 0
        description: Minimum stock level before reorder
      lastUpdated:
        type: datetime
        format: rfc3339
        description: Last inventory update timestamp
    example:
      inventoryId: "INV1234567"
      productId: "PRD1234567"
      warehouseId: "WH12345678"
      availableQuantity: 150
      reservedQuantity: 25
      totalQuantity: 175
      reorderLevel: 50
      lastUpdated: "2024-03-27T15:30:00.000Z"

  ReservationRequest:
    type: object
    properties:
      productId:
        type: ID
        description: Product to reserve
      quantity:
        type: integer
        minimum: 1
        description: Quantity to reserve
      orderId:
        type: ID
        description: Order requiring the reservation
      expiresAt:
        type: datetime
        format: rfc3339
        required: false
        description: Reservation expiration time
    example:
      productId: "PRD1234567"
      quantity: 2
      orderId: "ORD1234567"
      expiresAt: "2024-03-27T16:30:00.000Z"

  ReservationResponse:
    type: object
    properties:
      reservationId:
        type: ID
        description: Unique reservation identifier
      productId:
        type: ID
        description: Reserved product
      quantity:
        type: integer
        description: Reserved quantity
      orderId:
        type: ID
        description: Order ID
      status:
        type: string
        enum: [RESERVED, EXPIRED, CANCELLED, FULFILLED]
        description: Reservation status
      reservedAt:
        type: datetime
        format: rfc3339
        description: Reservation timestamp
      expiresAt:
        type: datetime
        format: rfc3339
        required: false
        description: Reservation expiration
    example:
      reservationId: "RSV1234567"
      productId: "PRD1234567"
      quantity: 2
      orderId: "ORD1234567"
      status: "RESERVED"
      reservedAt: "2024-03-27T15:30:00.000Z"
      expiresAt: "2024-03-27T16:30:00.000Z"