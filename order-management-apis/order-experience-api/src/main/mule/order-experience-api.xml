<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core" 
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
      xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
                          http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
                          http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd
                          http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
                          http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd">
    
    <!-- API Configuration -->
    <apikit:config name="order-experience-api-config" 
                   api="api/order-experience-api.raml" 
                   outboundHeadersMapName="outboundHeaders" 
                   httpStatusVarName="httpStatus" />
    
    <!-- HTTP Listener Configuration -->
    <http:listener-config name="HTTP_Listener_config" doc:name="HTTP Listener config">
        <http:listener-connection host="0.0.0.0" port="8081" />
    </http:listener-config>
    
    <!-- HTTP Request Configuration for Process API -->
    <http:request-config name="Process_API_HTTP_Request_config" doc:name="Process API HTTP Request config">
        <http:request-connection host="localhost" port="8083" />
    </http:request-config>
    
    <!-- Object Store Configuration -->
    <os:object-store name="Order_Cache_Store" 
                     doc:name="Order Cache Store"
                     persistent="false" 
                     maxEntries="1000" 
                     entryTtl="300" />
    
    <!-- Main API Flow -->
    <flow name="order-experience-api-main">
        <http:listener doc:name="HTTP Listener" 
                       config-ref="HTTP_Listener_config" 
                       path="/api/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        
        <apikit:router config-ref="order-experience-api-config" />
        
        <error-handler>
            <on-error-propagate enableNotifications="true" 
                                logException="true" 
                                doc:name="On Error Propagate" 
                                type="APIKIT:BAD_REQUEST">
                <ee:transform doc:name="Bad Request Error">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  code: "BAD_REQUEST",
  message: "Invalid request format or missing required fields",
  timestamp: now(),
  correlationId: correlationId
}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">400</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate enableNotifications="true" 
                                logException="true" 
                                doc:name="On Error Propagate" 
                                type="APIKIT:NOT_FOUND">
                <ee:transform doc:name="Not Found Error">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  code: "NOT_FOUND",
  message: "The requested resource was not found",
  timestamp: now(),
  correlationId: correlationId
}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate enableNotifications="true" 
                                logException="true" 
                                doc:name="On Error Propagate" 
                                type="ANY">
                <ee:transform doc:name="Generic Error">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  code: "INTERNAL_ERROR",
  message: "An internal server error occurred",
  timestamp: now(),
  correlationId: correlationId
}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">500</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
        </error-handler>
    </flow>
    
    <!-- POST /orders Implementation -->
    <flow name="post:\orders:application\json:order-experience-api-config">
        <logger level="INFO" doc:name="Start Order Creation" 
                message="Creating order for customer: #[payload.customerId]" />
        
        <ee:transform doc:name="Set Variables and Validate">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    correlationId: vars.correlationId,
    customerId: payload.customerId,
    items: payload.items map (item, index) -> {
        productId: item.productId,
        quantity: item.quantity,
        unitPrice: item.unitPrice default null
    },
    shippingAddress: payload.shippingAddress,
    billingAddress: payload.billingAddress default payload.shippingAddress,
    paymentMethod: payload.paymentMethod,
    specialInstructions: payload.specialInstructions default "",
    promotionCode: payload.promotionCode default null,
    requestTimestamp: now()
}]]></ee:set-payload>
            </ee:message>
            <ee:variables>
                <ee:set-variable variableName="correlationId"><![CDATA[%dw 2.0
output application/java
---
correlationId default uuid()]]></ee:set-variable>
                <ee:set-variable variableName="startTime"><![CDATA[%dw 2.0
output application/java
---
now()]]></ee:set-variable>
                <ee:set-variable variableName="customerId"><![CDATA[%dw 2.0
output application/java
---
payload.customerId]]></ee:set-variable>
            </ee:variables>
            
        </ee:transform>
        
        <!-- Call Order Process API -->
        <http:request method="POST" 
                      doc:name="Call Order Process API" 
                      config-ref="Process_API_HTTP_Request_config" 
                      path="/process/orders" 
                      responseTimeout="30000">
            <http:headers>
                <![CDATA[#[output application/java
---
{
    "Content-Type" : "application/json",
    "X-Correlation-ID" : vars.correlationId,
    "Accept" : "application/json"
}]]]>
            </http:headers>
        </http:request>
        
        <!-- Cache Order Response -->
        <os:store doc:name="Cache Order Response" 
                  key="#[payload.orderId]" 
                  objectStore="Order_Cache_Store">
            <os:value>#[payload]</os:value>
        </os:store>
        
        <!-- Transform Response for Experience Layer -->
        <ee:transform doc:name="Transform Response">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    orderId: payload.orderId,
    customerId: payload.customerId,
    orderDate: payload.orderDate,
    status: payload.status,
    totalAmount: payload.totalAmount,
    currency: payload.currency default "USD",
    items: payload.items map (item) -> {
        productId: item.productId,
        productName: item.productName,
        quantity: item.quantity,
        unitPrice: item.unitPrice,
        totalPrice: item.totalPrice
    },
    shippingAddress: payload.shippingAddress,
    billingAddress: payload.billingAddress,
    estimatedDeliveryDate: payload.estimatedDeliveryDate,
    createdAt: payload.createdAt,
    updatedAt: payload.updatedAt
}]]></ee:set-payload>
            </ee:message>
            <ee:variables>
                <ee:set-variable variableName="httpStatus">201</ee:set-variable>
            </ee:variables>
        </ee:transform>
        
        <logger level="INFO" doc:name="Order Created Successfully" 
                message="Order created successfully: #[payload.orderId] in #[now() - vars.startTime] milliseconds" />
        
        <error-handler>
            <on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" type="HTTP:BAD_REQUEST">
                <ee:transform doc:name="Validation Error">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    code: "VALIDATION_ERROR",
    message: "Order validation failed",
    details: error.description,
    correlationId: vars.correlationId,
    timestamp: now()
}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">400</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" type="HTTP:TIMEOUT">
                <ee:transform doc:name="Timeout Error">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    code: "TIMEOUT_ERROR",
    message: "Order processing timed out",
    correlationId: vars.correlationId,
    timestamp: now()
}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">504</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" type="ANY">
                <ee:transform doc:name="Order Creation Error">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    code: "ORDER_CREATION_ERROR",
    message: "Failed to create order",
    details: error.description default "An error occurred during order processing",
    correlationId: vars.correlationId,
    timestamp: now()
}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">500</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
        </error-handler>
    </flow>
    
    <!-- GET /orders/{orderId} Implementation -->
    <flow name="get:\orders\(orderId):order-experience-api-config">
        <logger level="INFO" doc:name="Start Order Retrieval" 
                message="Retrieving order: #[attributes.uriParams.orderId]" />
        
        <ee:transform doc:name="Set Variables">
            <ee:variables>
                <ee:set-variable variableName="orderId"><![CDATA[%dw 2.0
output application/java
---
attributes.uriParams.orderId]]></ee:set-variable>
                <ee:set-variable variableName="correlationId"><![CDATA[%dw 2.0
output application/java
---
correlationId default uuid()]]></ee:set-variable>
            </ee:variables>
        </ee:transform>
        
        <!-- Try to get from cache first -->
        <try doc:name="Try Get from Cache">
            <os:retrieve doc:name="Get from Cache" 
                         key="#[vars.orderId]" 
                         objectStore="Order_Cache_Store" />
            <logger level="INFO" doc:name="Cache Hit" message="Order found in cache: #[vars.orderId]" />
        </try>
        
        <!-- If not in cache, call Process API -->
        <choice doc:name="Order Found in Cache?">
            <when expression="#[payload != null]">
                <logger level="DEBUG" doc:name="Using Cached Data" message="Using cached order data" />
            </when>
            <otherwise>
                <logger level="DEBUG" doc:name="Cache Miss" message="Order not in cache, calling Process API" />
                
                <http:request method="GET" 
                              doc:name="Get Order from Process API" 
                              config-ref="Process_API_HTTP_Request_config" 
                              path="/process/orders/#[vars.orderId]" 
                              responseTimeout="15000">
                    <http:headers>
                        <![CDATA[#[output application/java
---
{
    "X-Correlation-ID" : vars.correlationId,
    "Accept" : "application/json"
}]]]>
                    </http:headers>
                </http:request>
                
                <!-- Cache the response -->
                <os:store doc:name="Cache Response" 
                          key="#[vars.orderId]" 
                          objectStore="Order_Cache_Store">
                    <os:value>#[payload]</os:value>
                </os:store>
            </otherwise>
        </choice>
        
        <!-- Transform Response -->
        <ee:transform doc:name="Transform Order Response">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    orderId: payload.orderId,
    customerId: payload.customerId,
    orderDate: payload.orderDate,
    status: payload.status,
    totalAmount: payload.totalAmount,
    currency: payload.currency,
    items: payload.items,
    shippingAddress: payload.shippingAddress,
    billingAddress: payload.billingAddress,
    paymentMethod: payload.paymentMethod,
    specialInstructions: payload.specialInstructions,
    trackingNumber: payload.trackingNumber default null,
    estimatedDeliveryDate: payload.estimatedDeliveryDate default null,
    actualDeliveryDate: payload.actualDeliveryDate default null,
    createdAt: payload.createdAt,
    updatedAt: payload.updatedAt
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        
        <error-handler>
            <on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" type="HTTP:NOT_FOUND">
                <ee:transform doc:name="Order Not Found">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    code: "ORDER_NOT_FOUND",
    message: "Order with ID " ++ vars.orderId ++ " was not found",
    correlationId: vars.correlationId,
    timestamp: now()
}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" type="ANY">
                <ee:transform doc:name="Order Retrieval Error">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    code: "ORDER_RETRIEVAL_ERROR",
    message: "Failed to retrieve order",
    details: error.description default "An error occurred while retrieving order data",
    correlationId: vars.correlationId,
    timestamp: now()
}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">500</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
        </error-handler>
    </flow>
    
    <!-- GET /orders Implementation -->
    <flow name="get:\orders:order-experience-api-config">
        <logger level="INFO" doc:name="Start Orders List" 
                message="Listing orders with parameters: #[attributes.queryParams]" />
        
        <ee:transform doc:name="Set Variables">
            <ee:variables>
                <ee:set-variable variableName="correlationId"><![CDATA[%dw 2.0
output application/java
---
correlationId default uuid()]]></ee:set-variable>
                <ee:set-variable variableName="queryParams"><![CDATA[%dw 2.0
output application/java
---
attributes.queryParams]]></ee:set-variable>
            </ee:variables>
        </ee:transform>
        
        <!-- Call Process API -->
        <http:request method="GET" 
                      doc:name="List Orders from Process API" 
                      config-ref="Process_API_HTTP_Request_config" 
                      path="/process/orders" 
                      responseTimeout="20000">
            <http:query-params><![CDATA[#[vars.queryParams]]]></http:query-params>
            <http:headers>
                <![CDATA[#[output application/java
---
{
    "X-Correlation-ID" : vars.correlationId,
    "Accept" : "application/json"
}]]]>
            </http:headers>
        </http:request>
        
        <!-- Transform Response -->
        <ee:transform doc:name="Transform Orders List">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    orders: payload.orders map (order) -> {
        orderId: order.orderId,
        customerId: order.customerId,
        orderDate: order.orderDate,
        status: order.status,
        totalAmount: order.totalAmount,
        currency: order.currency,
        itemCount: sizeOf(order.items default []),
        estimatedDeliveryDate: order.estimatedDeliveryDate default null
    },
    pagination: {
        total: payload.pagination.total,
        limit: payload.pagination.limit,
        offset: payload.pagination.offset,
        hasNext: payload.pagination.hasNext,
        hasPrevious: payload.pagination.hasPrevious
    }
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        
        <error-handler>
            <on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" type="ANY">
                <ee:transform doc:name="List Orders Error">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    code: "ORDER_LIST_ERROR",
    message: "Failed to retrieve orders list",
    details: error.description default "An error occurred while retrieving orders",
    correlationId: vars.correlationId,
    timestamp: now()
}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">500</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
        </error-handler>
    </flow>
    
    <!-- Health Check Implementation -->
    <flow name="get:\health:order-experience-api-config">
        <logger level="DEBUG" doc:name="Health Check" message="Health check requested" />
        
        <ee:transform doc:name="Health Response">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    status: "UP",
    timestamp: now(),
    version: "v1.0.0",
    environment: "development",
    dependencies: {
        orderProcessAPI: "UP",
        objectStore: "UP"
    },
    metrics: {
        responseTime: "150ms",
        memoryUsage: "65%",
        cpuUsage: "45%"
    }
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>
    
</mule>
