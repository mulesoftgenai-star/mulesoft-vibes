#%RAML 1.0 Library

usage: Common data types used across Process APIs

types:
  Error:
    type: object
    properties:
      code:
        type: string
        description: Error code
        example: PROCESS_ERROR
      message:
        type: string
        description: Human readable error message
        example: Order processing failed
      details?:
        type: string
        description: Additional error details
      timestamp:
        type: datetime
        description: Error timestamp
      correlationId?:
        type: string
        description: Correlation ID for tracking
      path?:
        type: string
        description: API path where error occurred

  ValidationError:
    type: Error
    properties:
      fields?:
        type: FieldError[]
        description: Field-specific validation errors

  FieldError:
    type: object
    properties:
      field:
        type: string
        description: Field name that failed validation
      code:
        type: string
        description: Validation error code
      message:
        type: string
        description: Validation error message

  ProcessingError:
    type: Error
    properties:
      stage:
        type: string
        description: Processing stage where error occurred
      retryable:
        type: boolean
        description: Whether the error is retryable
      retryAfter?:
        type: integer
        description: Suggested retry delay in seconds

  SuccessResponse:
    type: object
    properties:
      message:
        type: string
        description: Success message
      timestamp:
        type: datetime
        description: Response timestamp
      correlationId?:
        type: string
        description: Correlation ID for tracking

  HealthStatus:
    type: object
    properties:
      status:
        type: string
        enum: [UP, DOWN, DEGRADED]
        description: Overall health status
      timestamp:
        type: datetime
        description: Health check timestamp
      version:
        type: string
        description: API version
      environment?:
        type: string
        description: Environment name
      dependencies?:
        type: object
        description: Dependency health status
      metrics?:
        type: object
        description: Performance metrics
      errors?:
        type: array
        description: Error details when status is DOWN