#%RAML 1.0
title: Order Experience API
version: v2
description: |
  Experience Layer API for Order Management System Integration.
  Provides customer-facing order operations with optimized user experience.
baseUri: https://api.{environment}.company.com/orders/{version}
protocols: [HTTPS]
mediaType: application/json

documentation:
  - title: Order Management System Integration
    content: |
      This API provides a unified interface for order management operations
      including order creation, retrieval, updates, and lifecycle management.

securitySchemes:
  OAuth2:
    description: OAuth 2.0 client credentials grant
    type: OAuth 2.0
    settings:
      authorizationUri: https://auth.{environment}.company.com/oauth/authorize
      accessTokenUri: https://auth.{environment}.company.com/oauth/token
      authorizationGrants: [client_credentials]
      scopes: [read, write]

traits:
  pageable:
    queryParameters:
      page:
        description: Page number (starting from 0)
        type: integer
        minimum: 0
        default: 0
        example: 0
      size:
        description: Number of items per page
        type: integer
        minimum: 1
        maximum: 100
        default: 20
        example: 20
  sortable:
    queryParameters:
      sort:
        description: Sort criteria (field,direction)
        type: string[]
        example: ["orderDate,desc", "totalAmount,asc"]
  filterable:
    queryParameters:
      customerId:
        description: Filter by customer ID
        type: string
        pattern: ^CUST[0-9]{6}$
        example: CUST123456
      status:
        description: Filter by order status
        type: string
        enum: [PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED]
        example: CONFIRMED
      startDate:
        description: Filter orders from this date (inclusive)
        type: date-only
        example: 2026-01-01
      endDate:
        description: Filter orders until this date (inclusive)
        type: date-only
        example: 2026-12-31

types:
  Order:
    type: object
    properties:
      orderId:
        type: string
        pattern: ^ORD[0-9]{8}$
        example: ORD12345678
      customerId:
        type: string
        pattern: ^CUST[0-9]{6}$
        example: CUST123456
      orderDate:
        type: datetime
        format: rfc3339
        example: 2026-03-24T10:30:00Z
      orderStatus:
        type: string
        enum: [PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED]
        example: CONFIRMED
      items:
        type: OrderItem[]
        minItems: 1
        maxItems: 50
      totalAmount:
        type: number
        multipleOf: 0.01
        minimum: 0
        example: 299.99
      currency:
        type: string
        pattern: ^[A-Z]{3}$
        default: USD
        example: USD
      shippingAddress:
        type: Address
      paymentDetails:
        type: PaymentDetails
      trackingNumber?:
        type: string
        example: TRK123456789
      estimatedDelivery?:
        type: date-only
        example: 2026-03-30
      createdAt:
        type: datetime
        format: rfc3339
        example: 2026-03-24T10:30:00Z
      updatedAt:
        type: datetime
        format: rfc3339
        example: 2026-03-24T11:45:00Z

  OrderItem:
    type: object
    properties:
      productId:
        type: string
        pattern: ^PROD[0-9]{3}$
        example: PROD789
      productName:
        type: string
        minLength: 1
        maxLength: 100
        example: Premium Laptop
      quantity:
        type: integer
        minimum: 1
        maximum: 999
        example: 2
      unitPrice:
        type: number
        multipleOf: 0.01
        minimum: 0
        example: 149.99
      totalPrice:
        type: number
        multipleOf: 0.01
        minimum: 0
        example: 299.98

  Address:
    type: object
    properties:
      street:
        type: string
        minLength: 1
        maxLength: 100
        example: 123 Main Street
      city:
        type: string
        minLength: 1
        maxLength: 50
        example: Anytown
      state:
        type: string
        minLength: 2
        maxLength: 50
        example: California
      zipCode:
        type: string
        pattern: ^[0-9]{5}(-[0-9]{4})?$
        example: 12345
      country:
        type: string
        pattern: ^[A-Z]{3}$
        default: USA
        example: USA

  PaymentDetails:
    type: object
    properties:
      paymentMethod:
        type: string
        enum: [CREDIT_CARD, DEBIT_CARD, PAYPAL, APPLE_PAY, GOOGLE_PAY]
        example: CREDIT_CARD
      paymentStatus:
        type: string
        enum: [PENDING, AUTHORIZED, CAPTURED, FAILED, REFUNDED]
        example: AUTHORIZED
      transactionId?:
        type: string
        example: TXN987654321
      cardLast4?:
        type: string
        pattern: ^[0-9]{4}$
        example: 1234

  OrderRequest:
    type: object
    properties:
      customerId:
        type: string
        pattern: ^CUST[0-9]{6}$
        example: CUST123456
      items:
        type: OrderItemRequest[]
        minItems: 1
        maxItems: 50
      shippingAddress:
        type: Address
      paymentDetails:
        type: PaymentRequest

  OrderItemRequest:
    type: object
    properties:
      productId:
        type: string
        pattern: ^PROD[0-9]{3}$
        example: PROD789
      quantity:
        type: integer
        minimum: 1
        maximum: 999
        example: 2
      unitPrice:
        type: number
        multipleOf: 0.01
        minimum: 0
        example: 149.99

  PaymentRequest:
    type: object
    properties:
      paymentMethod:
        type: string
        enum: [CREDIT_CARD, DEBIT_CARD, PAYPAL, APPLE_PAY, GOOGLE_PAY]
        example: CREDIT_CARD
      cardToken:
        type: string
        description: Tokenized card information for security
        example: tok_1234567890abcdef

  OrderStatusUpdate:
    type: object
    properties:
      status:
        type: string
        enum: [CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED]
        example: SHIPPED
      reason?:
        type: string
        maxLength: 255
        example: Order shipped via FedEx
      trackingNumber?:
        type: string
        example: TRK123456789

  OrderList:
    type: object
    properties:
      orders:
        type: Order[]
      pagination:
        type: PaginationInfo

  PaginationInfo:
    type: object
    properties:
      page:
        type: integer
        minimum: 0
        example: 0
      size:
        type: integer
        minimum: 1
        example: 20
      totalElements:
        type: integer
        minimum: 0
        example: 150
      totalPages:
        type: integer
        minimum: 0
        example: 8
      first:
        type: boolean
        example: true
      last:
        type: boolean
        example: false

  Error:
    type: object
    properties:
      error:
        type: object
        properties:
          code:
            type: string
            example: ORDER_NOT_FOUND
          message:
            type: string
            example: Order not found with provided ID
          timestamp:
            type: datetime
            format: rfc3339
            example: 2026-03-24T10:30:00Z
          correlationId:
            type: string
            example: cor-123e4567-e89b-12d3-a456-426614174000
          path:
            type: string
            example: /api/v2/orders/ORD12345678
      metadata:
        type: object
        properties:
          version:
            type: string
            example: "2.0"
          environment:
            type: string
            example: production

/orders:
  displayName: Orders
  description: Order management operations
  
  get:
    displayName: List Orders
    description: Retrieve a paginated list of orders with optional filtering and sorting
    is: [pageable, sortable, filterable]
    securedBy: [OAuth2]
    queryParameters:
      customerId:
        required: false
      status:
        required: false
    responses:
      200:
        description: Successfully retrieved orders
        body:
          application/json:
            type: OrderList
            example: |
              {
                "orders": [
                  {
                    "orderId": "ORD12345678",
                    "customerId": "CUST123456",
                    "orderDate": "2026-03-24T10:30:00Z",
                    "orderStatus": "CONFIRMED",
                    "items": [
                      {
                        "productId": "PROD789",
                        "productName": "Premium Laptop",
                        "quantity": 1,
                        "unitPrice": 1299.99,
                        "totalPrice": 1299.99
                      }
                    ],
                    "totalAmount": 1299.99,
                    "currency": "USD",
                    "shippingAddress": {
                      "street": "123 Main Street",
                      "city": "Anytown",
                      "state": "California",
                      "zipCode": "12345",
                      "country": "USA"
                    },
                    "paymentDetails": {
                      "paymentMethod": "CREDIT_CARD",
                      "paymentStatus": "AUTHORIZED",
                      "cardLast4": "1234"
                    },
                    "createdAt": "2026-03-24T10:30:00Z",
                    "updatedAt": "2026-03-24T10:35:00Z"
                  }
                ],
                "pagination": {
                  "page": 0,
                  "size": 20,
                  "totalElements": 150,
                  "totalPages": 8,
                  "first": true,
                  "last": false
                }
              }
      400:
        description: Invalid request parameters
        body:
          application/json:
            type: Error
      401:
        description: Unauthorized access
        body:
          application/json:
            type: Error
      500:
        description: Internal server error
        body:
          application/json:
            type: Error
  
  post:
    displayName: Create Order
    description: Create a new order with customer, items, and payment information
    securedBy: [OAuth2]
    body:
      application/json:
        type: OrderRequest
        example: |
          {
            "customerId": "CUST123456",
            "items": [
              {
                "productId": "PROD789",
                "quantity": 2,
                "unitPrice": 149.99
              }
            ],
            "shippingAddress": {
              "street": "123 Main Street",
              "city": "Anytown",
              "state": "California",
              "zipCode": "12345",
              "country": "USA"
            },
            "paymentDetails": {
              "paymentMethod": "CREDIT_CARD",
              "cardToken": "tok_1234567890abcdef"
            }
          }
    responses:
      201:
        description: Order created successfully
        body:
          application/json:
            type: Order
            example: |
              {
                "orderId": "ORD12345678",
                "customerId": "CUST123456",
                "orderDate": "2026-03-24T10:30:00Z",
                "orderStatus": "PENDING",
                "items": [
                  {
                    "productId": "PROD789",
                    "productName": "Premium Laptop",
                    "quantity": 2,
                    "unitPrice": 149.99,
                    "totalPrice": 299.98
                  }
                ],
                "totalAmount": 299.98,
                "currency": "USD",
                "shippingAddress": {
                  "street": "123 Main Street",
                  "city": "Anytown",
                  "state": "California",
                  "zipCode": "12345",
                  "country": "USA"
                },
                "paymentDetails": {
                  "paymentMethod": "CREDIT_CARD",
                  "paymentStatus": "PENDING"
                },
                "createdAt": "2026-03-24T10:30:00Z",
                "updatedAt": "2026-03-24T10:30:00Z"
              }
      400:
        description: Invalid order request
        body:
          application/json:
            type: Error
      401:
        description: Unauthorized access
        body:
          application/json:
            type: Error
      409:
        description: Business rule violation (e.g., insufficient inventory)
        body:
          application/json:
            type: Error
      500:
        description: Internal server error
        body:
          application/json:
            type: Error

  /{orderId}:
    displayName: Individual Order
    description: Operations on a specific order
    uriParameters:
      orderId:
        type: string
        pattern: ^ORD[0-9]{8}$
        example: ORD12345678
        description: Unique order identifier
    
    get:
      displayName: Get Order
      description: Retrieve details of a specific order by ID
      securedBy: [OAuth2]
      responses:
        200:
          description: Successfully retrieved order
          body:
            application/json:
              type: Order
        400:
          description: Invalid order ID format
          body:
            application/json:
              type: Error
        401:
          description: Unauthorized access
          body:
            application/json:
              type: Error
        404:
          description: Order not found
          body:
            application/json:
              type: Error
        500:
          description: Internal server error
          body:
            application/json:
              type: Error
    
    /status:
      displayName: Order Status
      description: Order status management
      
      patch:
        displayName: Update Order Status
        description: Update the status of an existing order
        securedBy: [OAuth2]
        body:
          application/json:
            type: OrderStatusUpdate
            example: |
              {
                "status": "SHIPPED",
                "reason": "Order shipped via FedEx",
                "trackingNumber": "TRK123456789"
              }
        responses:
          200:
            description: Order status updated successfully
            body:
              application/json:
                type: Order
          400:
            description: Invalid status update request
            body:
              application/json:
                type: Error
          401:
            description: Unauthorized access
            body:
              application/json:
                type: Error
          404:
            description: Order not found
            body:
              application/json:
                type: Error
          409:
            description: Invalid status transition
            body:
              application/json:
                type: Error
          500:
            description: Internal server error
            body:
              application/json:
                type: Error

/health:
  displayName: Health Check
  description: API health status endpoint
  
  get:
    displayName: Health Status
    description: Check the health and availability of the API
    responses:
      200:
        description: API is healthy
        body:
          application/json:
            example: |
              {
                "status": "UP",
                "timestamp": "2026-03-24T10:30:00Z",
                "version": "2.0",
                "environment": "production",
                "dependencies": {
                  "database": "UP",
                  "processAPI": "UP",
                  "systemAPIs": "UP"
                }
              }
      503:
        description: API is unavailable
        body:
          application/json:
            example: |
              {
                "status": "DOWN",
                "timestamp": "2026-03-24T10:30:00Z",
                "version": "2.0",
                "environment": "production",
                "dependencies": {
                  "database": "DOWN",
                  "processAPI": "UP",
                  "systemAPIs": "DEGRADED"
                }
              }