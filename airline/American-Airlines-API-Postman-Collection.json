                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/flights",
              "host": ["{{baseUrl}}"],
              "path": ["api", "flights"]
            },
            "description": "Retrieve all available flights"
          },
          "response": [
            {
              "name": "Success Response",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/flights",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "flights"]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
