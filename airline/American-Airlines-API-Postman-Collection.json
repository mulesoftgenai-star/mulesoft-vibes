                  "raw": "{{baseUrl}}/api/flights/1",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "flights", "1"]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"ID\": 1,\n  \"code\": \"AA1001\",\n  \"price\": 500,\n  \"departureDate\": \"2024-02-15\",\n  \"origin\": \"LAX\",\n  \"destination\": \"JFK\",\n  \"emptySeats\": 150,\n  \"plane\": {\n    \"type\": \"Boeing 737\",\n    \"totalSeats\": 180\n  }\n}"
            },
            {
              "name": "Flight Not Found",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/flights/999",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "flights", "999"]
                }
              },
              "status": "Not Found",
              "code": 404,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"message\": \"Flight not found\"\n}"
            }
          ]
        },
        {
          "name": "Search Flights by Destination",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/flights?destination=JFK",
              "host": ["{{baseUrl}}"],
              "path": ["api", "flights"],
              "query": [
                {
                  "key": "destination",
                  "value": "JFK",
                  "description": "Destination airport code"
                }
              ]
            },
            "description": "Search flights by destination airport code"
          },
          "response": [
            {
              "name": "Success Response",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/flights?destination=JFK",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "flights"],
                  "query": [
                    {
                      "key": "destination",
                      "value": "JFK"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "[\n  {\n    \"ID\": 1,\n    \"code\": \"AA1001\",\n    \"price\": 500,\n    \"departureDate\": \"2024-02-15\",\n    \"origin\": \"LAX\",\n    \"destination\": \"JFK\",\n    \"emptySeats\": 150,\n    \"plane\": {\n      \"type\": \"Boeing 737\",\n      \"totalSeats\": 180\n    }\n  }\n]"
            }
          ]
