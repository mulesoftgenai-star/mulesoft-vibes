            ],
            "url": {
              "raw": "{{baseUrl}}/api/flights/:ID",
              "host": ["{{baseUrl}}"],
              "path": ["api", "flights", ":ID"],
              "variable": [
                {
                  "key": "ID",
                  "value": "1",
                  "description": "Flight ID"
                }
              ]
            },
            "description": "Retrieve a specific flight by its ID"
