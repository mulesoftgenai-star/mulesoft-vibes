            "body": {
              "mode": "raw",
              "raw": "{\n  \"ID\": 2,\n  \"code\": \"AA2001\",\n  \"price\": 650,\n  \"departureDate\": \"2024/03/20\",\n  \"origin\": \"DFW\",\n  \"destination\": \"MIA\",\n  \"emptySeats\": 160,\n  \"plane\": {\n    \"type\": \"Boeing 777\",\n    \"totalSeats\": 200\n  }\n}"
