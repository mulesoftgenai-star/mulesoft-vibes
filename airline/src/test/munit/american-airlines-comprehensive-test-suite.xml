				<http:query-params><![CDATA[#[output application/java
---
{
	"destination" : "SFO"
}]]]></http:query-params>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-equals doc:name="Assert Status Code 200" actual="#[attributes.statusCode]" expected="#[200]"/>
			<munit-tools:assert-that doc:name="Assert Response is Array" expression="#[payload]" is="#[MunitTools::hasSize(1)]"/>
			<munit-tools:assert-equals doc:name="Assert Flight Destination" actual="#[payload[0].destination]" expected="#['SFO']"/>
