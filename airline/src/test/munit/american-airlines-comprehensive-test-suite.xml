		http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">
	
	<munit:config name="american-airlines-comprehensive-test-suite.xml" />

	<!-- HTTP Request Configuration -->
	<http:request-config name="HTTP_Request_configuration" doc:name="HTTP Request configuration">
		<http:request-connection protocol="HTTP" host="localhost" port="8081" />
	</http:request-config>

	<!-- Test Configuration -->
	<munit:before-suite name="before-suite">
		<munit-tools:mock-when doc:name="Mock Database Config" processor="db:config">
			<munit-tools:then-return>
				<munit-tools:payload value="#[null]"/>
			</munit-tools:then-return>
		</munit-tools:mock-when>
	</munit:before-suite>

	<!-- =============================================== -->
	<!-- HAPPY PATH TEST CASES -->
	<!-- =============================================== -->

	<munit:test name="test-get-all-flights-happy-path" doc:id="01" description="Test successful retrieval of all flights">
		<munit:execution>
			<munit-tools:mock-when doc:name="Mock DB Select All Flights" processor="db:select">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute whereValue="select-all-flights" attributeName="config-ref"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[[
						{
							'ID': 1,
							'code': 'AA001',
							'price': 299.99,
							'departureDate': '2024-08-15',
							'origin': 'LAX',
							'destination': 'SFO',
							'emptySeats': 25,
							'plane': {
								'type': 'Boeing 737',
								'totalSeats': 150
							}
						},
						{
							'ID': 2,
							'code': 'AA002',
							'price': 450.50,
							'departureDate': '2024-08-16',
							'origin': 'SFO',
							'destination': 'CLE',
							'emptySeats': 30,
							'plane': {
								'type': 'Airbus A320',
								'totalSeats': 180
							}
						}
					]]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<http:request method="GET" doc:name="GET All Flights" config-ref="HTTP_Request_configuration" path="/api/flights"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-equals doc:name="Assert Status Code 200" actual="#[attributes.statusCode]" expected="#[200]"/>
			<munit-tools:assert-that doc:name="Assert Response is Array" expression="#[payload]" is="#[MunitTools::hasSize(2)]"/>
			<munit-tools:assert-equals doc:name="Assert First Flight Code" actual="#[payload[0].code]" expected="#['AA001']"/>
			<munit-tools:assert-equals doc:name="Assert First Flight Price" actual="#[payload[0].price]" expected="#[299.99]"/>
		</munit:validation>
	</munit:test>

	<munit:test name="test-get-flights-by-destination-happy-path" doc:id="02" description="Test successful retrieval of flights by destination">
		<munit:execution>
			<munit-tools:mock-when doc:name="Mock DB Select Flights by Destination" processor="db:select">
