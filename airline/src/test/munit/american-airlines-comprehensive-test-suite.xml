					<munit-tools:with-attribute whereValue="select-flights-by-destination" attributeName="config-ref"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[[
						{
							'ID': 1,
							'code': 'AA001',
							'price': 299.99,
							'departureDate': '2024-08-15',
							'origin': 'LAX',
							'destination': 'SFO',
							'emptySeats': 25,
							'plane': {
								'type': 'Boeing 737',
