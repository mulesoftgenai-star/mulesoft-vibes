	<munit:test name="getAllFlights-success-complete-data" doc:id="getAllFlights-success-complete-data" description="Test getAllFlights flow with complete data set and verify DataWeave transformation">
		<munit:behavior>
			<munit-tools:mock-when doc:name="Mock Database Select Success" doc:id="mock-db-select-success" processor="db:select">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute whereValue="MySql_Database_Config" attributeName="config-ref" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value='#[[
						{
							"ID": 1,
							"code1": "AA101",
							"price": 299.99,
							"takeOffDate": "2024-12-25T10:30:00",
							"fromAirport": "LAX",
							"toAirport": "NYC",
							"seatsAvailable": 150,
							"planeType": "Boeing 737",
							"totalSeats": 180
						},
						{
							"ID": 2,
							"code1": "AA102", 
							"price": 450.50,
							"takeOffDate": "2024-12-26T14:15:00",
							"fromAirport": "NYC",
							"toAirport": "LAX",
							"seatsAvailable": 120,
							"planeType": "Airbus A320",
							"totalSeats": 160
						}
					]]' />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<flow-ref doc:name="getAllFlights" doc:id="call-getAllFlights-success" name="getAllFlights" />
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="Assert payload not null" doc:id="assert-payload-not-null" expression="#[payload]" is="#[MunitTools::notNullValue()]" />
			<munit-tools:assert-that doc:name="Assert payload size is 2" doc:id="assert-payload-size-2" expression="#[sizeOf(payload)]" is="#[MunitTools::equalTo(2)]" />
			<munit-tools:assert-that doc:name="Assert first flight ID" doc:id="assert-first-flight-id" expression="#[payload[0].ID]" is="#[MunitTools::equalTo(1)]" />
			<munit-tools:assert-that doc:name="Assert first flight code" doc:id="assert-first-flight-code" expression="#[payload[0].code]" is="#[MunitTools::equalTo('AA101')]" />
			<munit-tools:assert-that doc:name="Assert first flight price" doc:id="assert-first-flight-price" expression="#[payload[0].price]" is="#[MunitTools::equalTo(299.99)]" />
			<munit-tools:assert-that doc:name="Assert first flight origin" doc:id="assert-first-flight-origin" expression="#[payload[0].origin]" is="#[MunitTools::equalTo('LAX')]" />
			<munit-tools:assert-that doc:name="Assert first flight destination" doc:id="assert-first-flight-dest" expression="#[payload[0].destination]" is="#[MunitTools::equalTo('NYC')]" />
			<munit-tools:assert-that doc:name="Assert second flight transformations" doc:id="assert-second-flight" expression="#[payload[1].code]" is="#[MunitTools::equalTo('AA102')]" />
		</munit:validation>
	</munit:test>
	
