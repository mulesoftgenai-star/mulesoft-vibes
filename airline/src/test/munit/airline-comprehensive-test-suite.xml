            <munit-tools:assert-that doc:name="Assert Negative Price Rejected" expression="#[attributes.statusCode]" is="#[MunitTools::equalTo(400)]"/>
        </munit:validation>
    </munit:test>

    <munit:test name="large-data-payload-test" description="Test handling of large data payload">
        <munit:execution>
            <http:request method="POST" doc:name="POST Large Payload" path="/api/flights" config-ref="HTTP_Request_configuration">
                <http:body><![CDATA[{
    "ID": 300,
    "code": "#[('A' * 1000)]",
    "price": 500,
    "departureDate": "2024/12/30",
    "origin": "NYC",
    "destination": "LAX",
    "emptySeats": 50,
    "plane": {
        "type": "Boeing 737",
        "totalSeats": 150
    }
}]]></http:body>
                <http:headers>
                    <http:header headerName="Content-Type" value="application/json" />
                </http:headers>
            </http:request>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="Assert Large Payload Handled" expression="#[attributes.statusCode]" is="#[MunitTools::anyOf([MunitTools::equalTo(400), MunitTools::equalTo(413)])]"/>
        </munit:validation>
    </munit:test>

    <!-- ===================================== -->
    <!-- HTTP Method Tests -->
    <!-- ===================================== -->
    
    <munit:test name="unsupported-http-method-test" description="Test unsupported HTTP method">
        <munit:execution>
            <http:request method="PATCH" doc:name="PATCH Unsupported" path="/api/flights/1" config-ref="HTTP_Request_configuration">
                <http:headers>
                    <http:header headerName="Content-Type" value="application/json" />
                </http:headers>
            </http:request>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="Assert Method Not Allowed" expression="#[attributes.statusCode]" is="#[MunitTools::equalTo(405)]"/>
        </munit:validation>
    </munit:test>

