		http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	
	<munit:config name="comprehensive-api-test-suite.xml" />
	
	<http:request-config name="HTTP_Request_configuration" doc:name="HTTP Request configuration">
		<http:request-connection protocol="HTTP" host="localhost" port="8083" />
	</http:request-config>
	
	<!-- ============================= -->
	<!-- HAPPY PATH TEST CASES -->
	<!-- ============================= -->
	
	<munit:test name="get-all-flights-happy-path-test" description="Test successful retrieval of all flights">
		<munit:execution>
			<http:request method="GET" doc:name="Get All Flights" config-ref="HTTP_Request_configuration" path="/api/flights">
				<http:headers><![CDATA[#[output application/java
---
{
	"Accept" : "application/json"
}]]]></http:headers>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="Verify Status Code is 200" is="#[MunitTools::equalTo(200)]" expression="#[attributes.statusCode]" />
			<munit-tools:assert-that doc:name="Verify Content-Type" is="#[MunitTools::containsString('application/json')]" expression="#[attributes.headers.'content-type']" />
			<munit-tools:assert-that doc:name="Verify Response is Array" is="#[MunitTools::instanceOf('java.util.List')]" expression="#[payload]" />
		</munit:validation>
	</munit:test>
	
	<munit:test name="get-flights-by-destination-cle-happy-path-test" description="Test successful retrieval of flights by destination CLE">
		<munit:execution>
			<http:request method="GET" doc:name="Get Flights by Destination CLE" config-ref="HTTP_Request_configuration" path="/api/flights">
				<http:headers><![CDATA[#[output application/java
---
{
	"Accept" : "application/json"
}]]]></http:headers>
				<http:query-params><![CDATA[#[output application/java
---
{
	"destination" : "CLE"
}]]]></http:query-params>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="Verify Status Code is 200" is="#[MunitTools::equalTo(200)]" expression="#[attributes.statusCode]" />
			<munit-tools:assert-that doc:name="Verify Content-Type" is="#[MunitTools::containsString('application/json')]" expression="#[attributes.headers.'content-type']" />
			<munit-tools:assert-that doc:name="Verify Response is Array" is="#[MunitTools::instanceOf('java.util.List')]" expression="#[payload]" />
		</munit:validation>
	</munit:test>
	
	<munit:test name="get-flight-by-id-happy-path-test" description="Test successful retrieval of flight by ID">
		<munit:execution>
			<http:request method="GET" doc:name="Get Flight by ID" config-ref="HTTP_Request_configuration" path="/api/flights/1">
				<http:headers><![CDATA[#[output application/java
---
{
	"Accept" : "application/json"
}]]]></http:headers>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="Verify Status Code is 200" is="#[MunitTools::equalTo(200)]" expression="#[attributes.statusCode]" />
			<munit-tools:assert-that doc:name="Verify Content-Type" is="#[MunitTools::containsString('application/json')]" expression="#[attributes.headers.'content-type']" />
			<munit-tools:assert-that doc:name="Verify Flight ID is 1" is="#[MunitTools::equalTo(1)]" expression="#[payload.ID]" />
		</munit:validation>
	</munit:test>
	
	<munit:test name="create-flight-happy-path-test" description="Test successful creation of a new flight">
		<munit:execution>
			<http:request method="POST" doc:name="Create Flight" config-ref="HTTP_Request_configuration" path="/api/flights">
				<http:body><![CDATA[{
    "ID": 100,
    "code": "AA999",
    "price": 450,
    "departureDate": "2024/12/15",
    "origin": "NYC",
    "destination": "MIA",
    "emptySeats": 30,
    "plane": {
        "type": "Boeing 737",
        "totalSeats": 150
    }
}]]></http:body>
				<http:headers><![CDATA[#[output application/java
---
{
	"Content-Type" : "application/json",
	"Accept" : "application/json"
}]]]></http:headers>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="Verify Status Code is 201" is="#[MunitTools::equalTo(201)]" expression="#[attributes.statusCode]" />
			<munit-tools:assert-that doc:name="Verify Flight Created" is="#[MunitTools::containsString('Flight created')]" expression="#[payload.message as String default '']" />
		</munit:validation>
	</munit:test>
	
	<munit:test name="delete-flight-happy-path-test" description="Test successful deletion of a flight">
		<munit:execution>
			<http:request method="DELETE" doc:name="Delete Flight" config-ref="HTTP_Request_configuration" path="/api/flights/1">
				<http:headers><![CDATA[#[output application/java
---
{
	"Accept" : "application/json"
}]]]></http:headers>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="Verify Status Code is 200" is="#[MunitTools::equalTo(200)]" expression="#[attributes.statusCode]" />
			<munit-tools:assert-that doc:name="Verify Flight Deleted" is="#[MunitTools::containsString('Flight deleted')]" expression="#[payload.message as String default '']" />
		</munit:validation>
	</munit:test>
	
