	<!-- ============================= -->
	<!-- SECURITY TEST CASES -->
	<!-- ============================= -->
	
	<munit:test name="sql-injection-test" description="Test SQL injection protection">
		<munit:execution>
			<http:request method="GET" doc:name="SQL Injection Test" config-ref="HTTP_Request_configuration" path="/api/flights">
				<http:headers><![CDATA[#[output application/java
---
{
	"Accept" : "application/json"
}]]]></http:headers>
				<http:query-params><![CDATA[#[output application/java
---
{
	"destination" : "'; DROP TABLE flights; --"
}]]]></http:query-params>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="Verify Status Code is not 500" is="#[MunitTools::not(MunitTools::equalTo(500))]" expression="#[attributes.statusCode]" />
		</munit:validation>
	</munit:test>
	
	<munit:test name="xss-protection-test" description="Test XSS protection">
		<munit:execution>
			<http:request method="POST" doc:name="XSS Protection Test" config-ref="HTTP_Request_configuration" path="/api/flights">
				<http:body><![CDATA[{
    "ID": 106,
    "code": "<script>alert('xss')</script>",
    "price": 400,
    "departureDate": "2024/12/31",
    "origin": "<img src=x onerror=alert(1)>",
    "destination": "NYC",
    "emptySeats": 25,
    "plane": {
        "type": "Boeing 737",
        "totalSeats": 150
    }
}]]></http:body>
				<http:headers><![CDATA[#[output application/java
---
{
	"Content-Type" : "application/json",
	"Accept" : "application/json"
}]]]></http:headers>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="Verify Status Code is 400 or 201" is="#[MunitTools::anyOf([MunitTools::equalTo(400), MunitTools::equalTo(201)])]" expression="#[attributes.statusCode]" />
		</munit:validation>
	</munit:test>
	
