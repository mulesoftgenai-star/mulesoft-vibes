	<!-- PERFORMANCE AND LOAD TESTS -->
	<!-- ============================= -->
	
	<munit:test name="get-flights-concurrent-requests-test" description="Test concurrent requests to flights endpoint">
		<munit:execution>
			<parallel-foreach collection="#[1 to 5]" doc:name="Parallel Foreach">
				<http:request method="GET" doc:name="Concurrent Get Flights" config-ref="HTTP_Request_configuration" path="/api/flights">
					<http:headers><![CDATA[#[output application/java
---
{
	"Accept" : "application/json"
}]]]></http:headers>
				</http:request>
			</parallel-foreach>
		</munit:execution>
		<munit:validation>
