#%RAML 1.0 Trait

displayName: Audit Logging
description: Audit logging capabilities for compliance and security monitoring

headers:
  X-User-Id:
    type: string
    required: false
    description: ID of the user performing the operation
    pattern: ^user-[a-zA-Z0-9-]+$
    example: "user-12345-67890"
    
  X-Session-Id:
    type: string
    required: false
    description: Session identifier for the user
    pattern: ^session-[a-zA-Z0-9-]+$
    example: "session-abc123def456"
    
  X-Client-Application:
    type: string
    required: false
    description: Client application performing the operation
    example: "mobile-app-v1.2.3"
    
  X-Business-Context:
    type: string
    required: false
    description: Business context for the operation
    example: "order-processing"
    
  X-Audit-Reason:
    type: string
    required: false
    description: Reason for performing the operation (for sensitive operations)
    maxLength: 255
    example: "Customer requested order cancellation"
    
  X-Source-IP:
    type: string
    required: false
    description: Original IP address of the client
    pattern: ^(?:[0-9]{1,3}\.){3}[0-9]{1,3}$|^([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}$
    example: "192.168.1.100"
    
  X-User-Agent:
    type: string
    required: false
    description: User agent of the client application
    example: "MyApp/1.0 (iOS; Version 14.0)"

responses:
  200:
    headers:
      X-Audit-Id:
        type: string
        required: false
        description: Unique identifier for the audit log entry
        pattern: ^audit-[a-f0-9-]+$
        example: "audit-12345-67890-abcdef"
        
      X-Audit-Timestamp:
        type: string
        required: false
        description: Timestamp when the audit entry was created
        example: "2024-01-15T10:30:00.123Z"
        
      X-Compliance-Level:
        type: string
        required: false
        enum: [low, medium, high, critical]
        description: Compliance level for this operation
        example: "medium"

  201:
    headers:
      X-Audit-Id:
        type: string
        required: false
        description: Unique identifier for the audit log entry
        pattern: ^audit-[a-f0-9-]+$
        example: "audit-98765-43210-fedcba"
        
      X-Audit-Timestamp:
        type: string
        required: false
        description: Timestamp when the audit entry was created
        example: "2024-01-15T10:30:00.123Z"
        
      X-Compliance-Level:
        type: string
        required: false
        enum: [low, medium, high, critical]
        description: Compliance level for this operation
        example: "high"

  400:
    headers:
      X-Audit-Id:
        type: string
        required: false
        description: Audit ID for the failed request
        example: "audit-error-abc123def456"

  401:
    headers:
      X-Audit-Id:
        type: string
        required: false
        description: Audit ID for the unauthorized request
        example: "audit-unauthorized-def456ghi789"
        
      X-Security-Event:
        type: string
        required: false
        enum: [invalid_token, expired_token, missing_token, malformed_token]
        description: Type of security event that occurred
        example: "invalid_token"

  403:
    headers:
      X-Audit-Id:
        type: string
        required: false
        description: Audit ID for the forbidden request
        example: "audit-forbidden-ghi789jkl012"
        
      X-Security-Event:
        type: string
        required: false
        enum: [insufficient_permissions, access_denied, role_mismatch]
        description: Type of security event that occurred
        example: "insufficient_permissions"

  500:
    headers:
      X-Audit-Id:
        type: string
        required: false
        description: Audit ID for the error event
        example: "audit-error-jkl012mno345"
        
      X-Error-Category:
        type: string
        required: false
        enum: [system_error, integration_error, data_error, configuration_error]
        description: Category of the error for audit classification
        example: "system_error"