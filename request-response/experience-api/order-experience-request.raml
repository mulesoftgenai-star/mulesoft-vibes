#%RAML 1.0 DataType

displayName: Order Experience Request Types
description: Request data types for Order Experience API operations

type: object
properties:
  CreateOrderRequest:
    type: object
    properties:
      customerId:
        type: string
        required: true
        pattern: ^CUST[0-9A-Z]{5,}$
        description: Unique customer identifier
        example: "CUST12345"
      items:
        type: array
        required: true
        minItems: 1
        description: List of items to order
        items:
          type: object
          properties:
            productId:
              type: string
              required: true
              pattern: ^PROD[0-9A-Z]{3,}$
              description: Product identifier
              example: "PROD789"
            quantity:
              type: integer
              required: true
              minimum: 1
              maximum: 999
              description: Quantity to order
              example: 2
            unitPrice:
              type: number
              required: true
              minimum: 0.01
              multipleOf: 0.01
              description: Unit price of the product
              example: 299.99
      shippingAddress:
        type: object
        required: true
        properties:
          street:
            type: string
            required: true
            minLength: 1
            maxLength: 255
            description: Street address
            example: "123 Main St"
          city:
            type: string
            required: true
            minLength: 1
            maxLength: 100
            description: City name
            example: "San Francisco"
          state:
            type: string
            required: true
            minLength: 2
            maxLength: 100
            description: State or province
            example: "CA"
          zipCode:
            type: string
            required: true
            pattern: ^[0-9]{5}(-[0-9]{4})?$
            description: ZIP or postal code
            example: "94105"
          country:
            type: string
            required: true
            pattern: ^[A-Z]{2,3}$
            description: Country code
            example: "USA"
      billingAddress:
        type: object
        required: false
        properties:
          street:
            type: string
            required: true
            minLength: 1
            maxLength: 255
            description: Street address
            example: "123 Main St"
          city:
            type: string
            required: true
            minLength: 1
            maxLength: 100
            description: City name
            example: "San Francisco"
          state:
            type: string
            required: true
            minLength: 2
            maxLength: 100
            description: State or province
            example: "CA"
          zipCode:
            type: string
            required: true
            pattern: ^[0-9]{5}(-[0-9]{4})?$
            description: ZIP or postal code
            example: "94105"
          country:
            type: string
            required: true
            pattern: ^[A-Z]{2,3}$
            description: Country code
            example: "USA"
      paymentMethod:
        type: object
        required: true
        properties:
          type:
            type: string
            required: true
            enum: ["CREDIT_CARD", "DEBIT_CARD", "DIGITAL_WALLET", "BANK_TRANSFER"]
            description: Payment method type
            example: "CREDIT_CARD"
          cardNumber:
            type: string
            required: false
            pattern: ^\*{4}-\*{4}-\*{4}-[0-9]{4}$
            description: Masked card number
            example: "****-****-****-1234"
          expiryMonth:
            type: string
            required: false
            pattern: ^(0[1-9]|1[0-2])$
            description: Card expiry month
            example: "12"
          expiryYear:
            type: string
            required: false
            pattern: ^20[2-9][0-9]$
            description: Card expiry year
            example: "2025"
      specialInstructions:
        type: string
        required: false
        maxLength: 500
        description: Special delivery instructions
        example: "Handle with care"

  UpdateOrderRequest:
    type: object
    properties:
      shippingAddress:
        type: object
        required: false
        properties:
          street:
            type: string
            required: true
            minLength: 1
            maxLength: 255
            description: Street address
            example: "456 Oak Ave"
          city:
            type: string
            required: true
            minLength: 1
            maxLength: 100
            description: City name
            example: "San Francisco"
          state:
            type: string
            required: true
            minLength: 2
            maxLength: 100
            description: State or province
            example: "CA"
          zipCode:
            type: string
            required: true
            pattern: ^[0-9]{5}(-[0-9]{4})?$
            description: ZIP or postal code
            example: "94102"
          country:
            type: string
            required: true
            pattern: ^[A-Z]{2,3}$
            description: Country code
            example: "USA"
      specialInstructions:
        type: string
        required: false
        maxLength: 500
        description: Special delivery instructions
        example: "Updated: Please call before delivery"