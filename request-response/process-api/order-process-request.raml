#%RAML 1.0 DataType

displayName: Order Process API Request
description: Request data type for Order Process API operations

type: object
properties:
  processOrderRequest:
    type: object
    properties:
      orderId:
        type: string
        required: true
        description: Unique order identifier from experience layer
        example: "ORD-2024-001234"
      action:
        type: string
        required: true
        enum: ["VALIDATE", "PROCESS", "FULFILL", "CANCEL", "UPDATE"]
        description: Process action to be performed
        example: "PROCESS"
      customerData:
        type: object
        required: true
        properties:
          customerId:
            type: string
            required: true
            description: Customer identifier
            example: "CUST-12345"
          customerType:
            type: string
            required: false
            enum: ["REGULAR", "PREMIUM", "VIP"]
            description: Customer tier
            example: "PREMIUM"
          loyaltyPoints:
            type: integer
            required: false
            description: Available loyalty points
            example: 1250
      orderData:
        type: object
        required: true
        properties:
          orderItems:
            type: array
            required: true
            description: Items to be processed
            items:
              type: object
              properties:
                productId:
                  type: string
                  required: true
                  description: Product identifier
                  example: "PROD-98765"
                quantity:
                  type: integer
                  required: true
                  description: Requested quantity
                  example: 2
                reservationId:
                  type: string
                  required: false
                  description: Inventory reservation ID
                  example: "RSV-789123"
          totalAmount:
            type: number
            required: true
            description: Total order amount
            example: 657.95
          currency:
            type: string
            required: true
            description: Currency code
            example: "USD"
      paymentData:
        type: object
        required: true
        properties:
          paymentMethod:
            type: string
            required: true
            enum: ["CREDIT_CARD", "DEBIT_CARD", "DIGITAL_WALLET", "BANK_TRANSFER"]
            description: Payment method
            example: "CREDIT_CARD"
          paymentToken:
            type: string
            required: true
            description: Secure payment token
            example: "PAY_TOKEN_ABC123"
          amount:
            type: number
            required: true
            description: Payment amount
            example: 657.95
          authorizationId:
            type: string
            required: false
            description: Payment authorization ID
            example: "AUTH_456789"
      shippingData:
        type: object
        required: true
        properties:
          shippingAddress:
            type: object
            required: true
            properties:
              street:
                type: string
                required: true
                description: Street address
                example: "123 Main Street"
              city:
                type: string
                required: true
                description: City
                example: "New York"
              state:
                type: string
                required: true
                description: State
                example: "NY"
              zipCode:
                type: string
                required: true
                description: Postal code
                example: "10001"
              country:
                type: string
                required: true
                description: Country code
                example: "US"
          shippingMethod:
            type: string
            required: true
            enum: ["STANDARD", "EXPRESS", "OVERNIGHT", "SAME_DAY"]
            description: Shipping method
            example: "STANDARD"
          deliveryPreferences:
            type: object
            required: false
            properties:
              deliveryDate:
                type: date-only
                required: false
                description: Preferred delivery date
                example: "2024-04-15"
              timeSlot:
                type: string
                required: false
                enum: ["MORNING", "AFTERNOON", "EVENING"]
                description: Delivery time slot
                example: "MORNING"
              instructions:
                type: string
                required: false
                description: Delivery instructions
                example: "Leave at front door"
      businessRules:
        type: object
        required: false
        properties:
          applyDiscounts:
            type: boolean
            required: false
            description: Whether to apply applicable discounts
            default: true
            example: true
          validateInventory:
            type: boolean
            required: false
            description: Whether to validate inventory availability
            default: true
            example: true
          requirePaymentAuth:
            type: boolean
            required: false
            description: Whether payment authorization is required
            default: true
            example: true
          priority:
            type: string
            required: false
            enum: ["LOW", "NORMAL", "HIGH", "URGENT"]
            description: Processing priority
            default: "NORMAL"
            example: "NORMAL"